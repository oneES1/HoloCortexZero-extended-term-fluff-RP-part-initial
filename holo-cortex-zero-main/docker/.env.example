# == 多实例配置区 ==

# 数据目录
HCZ_DATA_DIR=

# 系统配置文件中 ADVANCED_USER_ID 为高级 context 主用户，BOT_PERSONA_DISPLAY_NAME 为 bot 名字

# 宿主协作组（默认取当前登录用户主组，通常为 1000）
HCZ_RUNTIME_UID=1000
HCZ_RUNTIME_GID=1000
HCZ_RUNTIME_UMASK=0002

# 用于区分不同实例的前缀
INSTANCE_NAME=

# 端口配置
HCZ_EXPOSE_PORT=20261

# NapCat WebUI 容器内监听端口；默认只通过 HCZ /napcat 内置反代访问，不对外开放。
NAPCAT_WEBUI_PORT=65535

# == 构建网络与镜像源配置 (可选，仅 docker build 使用) ==

# 国内构建如需让 build 容器访问宿主本机代理，可设置为 host；留空或 default 使用 Docker 默认构建网络。
HCZ_BUILD_NETWORK=default

# 仅 docker build 使用的临时代理。不要把 HCZ 业务 API / 模型代理写在这里。
HCZ_BUILD_HTTP_PROXY=
HCZ_BUILD_HTTPS_PROXY=
HCZ_BUILD_ALL_PROXY=
HCZ_BUILD_NO_PROXY=

# 国内构建可设置为 https://registry.npmmirror.com；留空使用 npm 官方默认源。
HCZ_NPM_REGISTRY=

# 国内构建可设置为 https://mirrors.aliyun.com/pypi/simple；留空使用 uv 默认源。
HCZ_UV_DEFAULT_INDEX=

# 国内构建可设置为 http://mirrors.cloud.tencent.com/debian；留空使用 Debian 官方默认源。
HCZ_APT_DEBIAN_MIRROR=
HCZ_APT_SECURITY_MIRROR=
HCZ_APT_NO_PROXY=

# == 其他配置 (不建议修改) ==


# 端口配置 (不对宿主机开放)
POSTGRES_EXPOSE_PORT=5432
QDRANT_EXPOSE_PORT=6333

# 数据库配置
POSTGRES_HOST=${INSTANCE_NAME}hcz_postgres
POSTGRES_USER=holo_cortex_zero
POSTGRES_PASSWORD=holo_cortex_zero
POSTGRES_DATABASE=holo_cortex_zero

# Qdrant 配置
QDRANT_URL=http://${INSTANCE_NAME}hcz_qdrant:6333

# == 密钥配置 (安装脚本自动填充) ==

# Qdrant API Key
QDRANT_API_KEY=

# OneBot 配置
ONEBOT_ACCESS_TOKEN=?SA0WZ4HhGgnpT1(

# 管理员密码
HCZ_ADMIN_USERNAME=admin
HCZ_ADMIN_PASSWORD=
