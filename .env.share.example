# == 多实例配置区 ==

COMPOSE_PROJECT_NAME=hcz

# 数据目录；生产部署可显式改为 /srv/holo_cortex_zero
HCZ_DATA_DIR=./data
HCZ_WORKSPACE_DIR=./workspace
HCZ_SOURCE_DIR=./holo-cortex-zero-main
HCZ_RUNTIME_UID=1000
HCZ_RUNTIME_GID=1000
HCZ_RUNTIME_UMASK=0002

# 用于区分不同实例的前缀
INSTANCE_NAME=

# 端口配置 (对外开放的端口)
HCZ_EXPOSE_PORT=20261

# 构建网络与镜像源配置（可选；仅 docker build 使用，不进入运行态业务配置）
HCZ_BUILD_NETWORK=default
HCZ_BUILD_HTTP_PROXY=
HCZ_BUILD_HTTPS_PROXY=
HCZ_BUILD_ALL_PROXY=
HCZ_BUILD_NO_PROXY=
HCZ_NPM_REGISTRY=
HCZ_UV_DEFAULT_INDEX=
HCZ_APT_DEBIAN_MIRROR=
HCZ_APT_SECURITY_MIRROR=
HCZ_APT_NO_PROXY=

# == 其他配置 ==

POSTGRES_HOST=hcz_postgres
POSTGRES_USER=holo_cortex_zero
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DATABASE=holo_cortex_zero
QDRANT_URL=http://hcz_qdrant:6333
QDRANT_API_KEY=
ONEBOT_ACCESS_TOKEN=
HCZ_ADMIN_USERNAME=admin
HCZ_ADMIN_PASSWORD=change_me_admin_password
