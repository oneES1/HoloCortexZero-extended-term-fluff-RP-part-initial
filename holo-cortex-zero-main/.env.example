# =============================================================================
# HoloCortexZero 开发环境配置示例
# =============================================================================
# 复制此文件为 .env.dev 并根据实际情况修改配置值
#
# 人话版：
# - 平时开发就用：uv run poe dev
# - 如果你想顺手看后端接口文档，用：uv run poe dev-docs
# - 这两个命令的区别只有“要不要打开后端文档页”，别的都一样
#
# 第一次启动：
# 1. cp .env.example .env.dev
# 2. pnpm --dir frontend install --frozen-lockfile
# 3. uv run poe dev
#
# 常用命令：
# - 前后端一起开发：uv run poe dev
# - 前后端一起开发并打开后端文档：uv run poe dev-docs
# - 只跑后端：uv run poe dev-backend
# - 只跑前端：uv run poe dev-frontend
# - 停开发依赖容器：uv run poe dev-deps-down

# =============================================================================
# 基础配置
# =============================================================================

# 数据目录 (默认: ./data；生产部署可显式改为 /srv/holo_cortex_zero)
HCZ_DATA_DIR=./data

# 系统配置文件中 ADVANCED_USER_ID 为高级 context 主用户，BOT_PERSONA_DISPLAY_NAME 为 bot 名字

# =============================================================================
# 数据库配置 (已预配置连接开发 Docker 服务)
# =============================================================================

# PostgreSQL 数据库配置
HCZ_USE_ENV_DATABASE=true
HCZ_POSTGRES_HOST=127.0.0.1
HCZ_POSTGRES_PORT=5433
HCZ_POSTGRES_USER=holo_cortex_zero
HCZ_POSTGRES_PASSWORD=holo_cortex_zero
HCZ_POSTGRES_DATABASE=holo_cortex_zero_dev

# Qdrant 向量数据库配置
HCZ_USE_ENV_QDRANT=true
HCZ_QDRANT_URL=http://127.0.0.1:6334
HCZ_QDRANT_API_KEY=your-qdrant-api-key

# =============================================================================
# 安全配置 (开发环境预设值，避免重复登录)
# =============================================================================

# JWT 密钥 (开发环境固定值)
HCZ_JWT_SECRET_KEY=dev-secret-key-for-development

# =============================================================================
# 服务配置
# =============================================================================

# 暴露端口 (默认: 20261)
HCZ_EXPOSE_PORT=20261

# 前端静态文件目录

# WebUI 管理员密码 (开发环境默认)
HCZ_ADMIN_PASSWORD=admin

# =============================================================================
# NoneBot 配置
# =============================================================================

# NoneBot 环境
ENVIRONMENT=dev

# 驱动器配置
DRIVER=~fastapi

# 主机和端口
HOST=0.0.0.0
PORT=20261

# 日志级别
LOG_LEVEL=DEBUG

# OneBot 访问令牌 (HCZ 一体化 NapCat 默认固定值)
ONEBOT_ACCESS_TOKEN=?SA0WZ4HhGgnpT1(

# NapCat WebUI 容器内监听端口；默认只通过 HCZ /napcat 内置反代访问。
NAPCAT_WEBUI_PORT=65535
